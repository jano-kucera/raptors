---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Banner from "../components/Banner.astro";
import CTA from "../components/CTA.astro";
import { brand } from "../config/brand";
import { Image } from "astro:assets";
import schluckspechtLogo from "../assets/images/sponsors/schluckspecht.jpg";
import burgerKingLogo from "../assets/images/sponsors/burger-king.webp";
import horvathLogo from "../assets/images/sponsors/horvath-floristik.png";
import daRohrerLogo from "../assets/images/sponsors/da-rohrer.png";
import generaliLogo from "../assets/images/sponsors/generali.webp";
import gwtLogo from "../assets/images/sponsors/gwt.png";
import gollubitsLogo from "../assets/images/sponsors/gollubits.svg";
import mewaldLogo from "../assets/images/sponsors/mewald.png";

const sponsors = [
  {
    title: "Schluckspecht Eisenstadt",
    link: "https://www.facebook.com/SchluckspechtEisenstadt/",
    logo: schluckspechtLogo,
    description: "Bier- und Weinbar mit urigem Flair in Eisenstadt.",
  },
  {
    title: "Burger King",
    link: "https://www.burgerking.at/",
    logo: burgerKingLogo,
    description: "Fast-Food Restaurant Kette.",
  },
  {
    title: "Horvath floristik+gartenbau",
    link: "https://www.blumen-horvath.at/",
    logo: horvathLogo,
    description: "Floristik und Gartenbau in Eisenstadt.",
  },
  {
    title: "Da Rohrer",
    link: "https://www.da-rohrer.at/",
    logo: daRohrerLogo,
    description: "Gourmet Leberkäse aus Siegendorf.",
  },
  {
    title: "Generali",
    link: "https://www.generali.at/",
    logo: generaliLogo,
    description: "Unter den Flügeln des Löwen.",
  },
  {
    title: "GWT",
    link: "https://www.gwt.at/",
    logo: gwtLogo,
    description: "Wasser- und Wärmetechnik.",
  },
  {
    title: "Gollubits",
    link: "https://www.gollubits.at/",
    logo: gollubitsLogo,
    description: "Holzbau aus Leidenschaft.",
  },
  {
    title: "Mewald",
    link: "https://www.mewald.at/",
    logo: mewaldLogo,
    description: "Tore & Zäune von Mewald.",
  },
];
---

<BaseLayout
  title="Sponsoren"
  description={`Explore the full range of services offered by ${brand.name}. From repairs to remodeling, we do it all.`}
>
  <Header slot="header" />

  <Banner title="Unsere Sponsoren" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">
          Danke an alle, die uns bereits unterstützenen!
        </h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          Unsere Sponsoren sind weit mehr als Logos auf Dressen oder Tafeln. Sie
          sind Partner, Wegbegleiter und Mitgestalter unseres Vereins.
        </p>
        <p class="mt-3 text-text-muted leading-relaxed">
          Ohne sie wäre Eishockey in unserer kleinen Region nicht das, was es
          ist: Ein Ort der Begegnung, der Emotionen und des Zusammenhalts.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {
          sponsors.map((sponsor, i) => (
            <a href={sponsor.link}>
              <div class="grid grid-cols-[1fr_2fr] place-items-center gap-5 rounded-lg border border-border bg-background p-6 shadow-sm">
                <div class="flex size-24 shrink-0 items-center justify-center rounded-lg">
                  {sponsor.logo ? (
                    <Image
                      src={sponsor.logo}
                      alt={sponsor.title}
                      height={150}
                      loading="lazy"
                      class="size-full object-contain"
                    />
                  ) : (
                    ""
                  )}
                </div>
                <div>
                  <h3 class="font-heading text-h3 font-semibold text-text">
                    {sponsor.title}
                  </h3>
                  <p class="mt-2 text-text-muted leading-relaxed">
                    {sponsor.description}
                  </p>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
