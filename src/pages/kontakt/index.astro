---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Banner from "../../components/Banner.astro";
import { brand } from "../../config/brand";
import { client } from "../../data/client";
---

<BaseLayout
  title="Kontakt"
  description={`Get in touch with ${brand.name}. Request a free quote or ask us a question.`}
>
  <Header slot="header" />

  <Banner title="Kontakt" />

  <section class="py-section">
    <div
      class="mx-auto grid max-w-site grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-5 lg:gap-14"
    >
      <!-- Form -->
      <div class="lg:col-span-3">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">
          Senden Sie uns eine Nachricht
        </h2>
        <p class="mt-2 mb-8 text-text-muted">
          Füllen Sie das untenstehende Formular aus, und wir melden uns bei
          Ihnen.
        </p>

        <form
          name="kontakt"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/kontakt/success"
          class="flex flex-col gap-5"
        >
          <input type="hidden" name="form-name" value="kontakt" />
          <p class="hidden" aria-hidden="true">
            <label
              >Leave this empty: <input
                name="bot-field"
                tabindex="-1"
                autocomplete="off"
              /></label
            >
          </p>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text"
              >Name <span class="text-accent" aria-hidden="true">*</span></span
            >
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              class="min-h-11 rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text"
              >E-Mail <span class="text-accent" aria-hidden="true">*</span
              ></span
            >
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              class="min-h-11 rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">Telefon</span>
            <input
              type="tel"
              name="phone"
              autocomplete="tel"
              inputmode="tel"
              class="min-h-11 rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text"
              >Nachricht <span class="text-accent" aria-hidden="true">*</span
              ></span
            >
            <textarea
              name="message"
              rows="5"
              required
              class="min-h-30 rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 resize-y"
            ></textarea>
          </label>

          <button
            type="submit"
            class="mt-2 inline-flex min-h-11 cursor-pointer items-center justify-center self-start rounded-md bg-accent px-8 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            Nachricht senden
          </button>
        </form>
      </div>

      <!-- Contact info sidebar -->
      <aside class="space-y-8 lg:col-span-2">
        <div>
          <h3 class="font-heading text-lg font-semibold text-text">
            Nachwuchsarbeit und Jugend
          </h3>
          <a
            href="tel:06706022304"
            class="mt-1 block text-primary-light font-medium transition-colors hover:text-primary"
            >Christoph Hajdusich - 0670 602 23 04</a
          >
          <span class="mx-2 text-text-muted">U14 / U17</span>

          <a
            href="tel:06769302834"
            class="mt-1 block text-primary-light font-medium transition-colors hover:text-primary"
            >Peter Petrovic - 0676 930 28 34</a
          >
          <span class="mx-2 text-text-muted">U10 / U12</span>
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">
            Kampfmannschaft und Saison
          </h3>
          <a
            href="tel:06643061049"
            class="mt-1 block text-primary-light font-medium transition-colors hover:text-primary"
            >Andreas Wagner - 0664 306 10 49</a
          >
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">
            Presse, Medien und Werbung
          </h3>
          <a
            href="tel:06649138511"
            class="mt-1 block text-primary-light font-medium transition-colors hover:text-primary"
            >Tatjana Cepnik - 0664 913 85 11</a
          >
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">E-Mail</h3>
          <a
            href={`mailto:${client.email}`}
            class="mt-1 block text-primary-light font-medium transition-colors hover:text-primary"
          >
            {client.email}
          </a>
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">
            Finden Sie uns
          </h3>
          <a
            href={client.address.mapLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 block text-text-muted transition-colors hover:text-text"
          >
            {client.address.lineOne}<br />
            {
              client.address.lineTwo && (
                <>
                  {client.address.lineTwo}
                  <br />
                </>
              )
            }
            {client.address.city}, {client.address.state}
            {client.address.zip}
          </a>
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">
            Unsere Bankverbindung
          </h3>
          <p class="mt-1 text-text-muted">
            IBAN: AT78 2026 7021 0124 3893
            <br />
            IBAN Jugend: AT78 2026 7020 1233 9319
          </p>
        </div>
      </aside>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
