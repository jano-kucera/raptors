---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Banner from "../components/Banner.astro";
import CTA from "../components/CTA.astro";
import { brand } from "../config/brand";
---

<BaseLayout
  title="Hockeycamp"
  description={`${brand.name} Hockeycamp — intensive training and development for hockey players.`}
>
  <Header slot="header" />

  <Banner title="Hockeycamp" />

  <!-- Content Section -->
  <section class="mx-auto max-w-site px-4 py-16 sm:px-6 lg:py-24">
    <div class="prose prose-invert mx-auto max-w-2xl">
      <h2>Willkommen zum Hockeycamp</h2>
      <p>Hier können Sie Informationen über unser Hockeycamp hinzufügen.</p>
    </div>
  </section>

  <!-- Google Form -->
  <section class="mx-auto max-w-site px-4 py-16 sm:px-6 lg:py-24">
    <iframe
      src="https://docs.google.com/forms/d/e/1FAIpQLSepQrX3GLPR7zPeFOaSrR98MihYHivyhXSHb5C4tLsaarpIFw/viewform?embedded=true"
      width="100%"
      height="756">Načítava sa…</iframe
    >
  </section>

  <CTA slot="footer" />
  <Footer slot="footer" />
</BaseLayout>
