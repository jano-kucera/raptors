---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { brand } from "../config/brand";
import { client } from "../data/client";
import { heroImage as localHeroImage } from "../config/images";

// Fallback Unsplash URL used until a local image is added to
// src/assets/images/hero/ and registered in src/config/images.ts
const PLACEHOLDER =
  "https://scontent-vie1-1.cdninstagram.com/v/t39.30808-6/367497622_17921975477767796_2894774884152003508_n.jpg?stp=dst-jpg_e35_tt6&_nc_cat=107&ig_cache_key=MzE3MzcwODQ2MTI0NTY1ODIyMg%3D%3D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNBUk9VU0VMX0lURU0ueHBpZHMuMTM2NC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=Z-xqFZVqnmQQ7kNvwGqr-0_&_nc_oc=AdpqdhstzllqbbkFhISAs1W89ATHcS6-Pky6YLoAT_mbidQ6AfCRzCI0O6pS0y2jXWGxC7FS7jQIGPrmnkBAxBxq&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent-vie1-1.cdninstagram.com&_nc_gid=ucx2URDYYkwbUwxD0N98Tw&_nc_ss=7a22e&oh=00_Af6WqhIc_l4TtvxZZjObMcqUw2l5uUFEgOxMDVNz0sO-aQ&oe=6A1A550B";

interface Props {
  topper?: string;
  heading?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
}

const {
  topper = "Est. 2003",
  heading = brand.tagline,
  description = brand.description,
  ctaLabel = "Kontaktieren Sie uns",
  ctaHref = "/kontakt",
  secondaryLabel = "Spielplan",
  secondaryHref = "/spielplan",
  imageSrc = localHeroImage ?? PLACEHOLDER,
  imageAlt = "Professional tradesperson at work",
} = Astro.props;
---

<section
  class="relative overflow-hidden bg-background py-12 sm:py-16 md:py-20 lg:py-24"
>
  <div
    class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-12"
  >
    <!-- Copy -->
    <div class="order-2 space-y-5 lg:order-1 lg:space-y-6">
      {
        topper && (
          <span class="inline-block rounded-full bg-accent/10 px-4 py-1.5 text-topper font-bold uppercase tracking-widest text-accent">
            {topper}
          </span>
        )
      }

      <h1
        class="font-heading text-display font-bold uppercase leading-none tracking-tight text-text"
        transition:name="hero-heading"
      >
        {heading}
      </h1>

      <p class="max-w-lg text-lead text-text-muted leading-relaxed">
        {description}
      </p>

      <!-- CTA row -->
      <div
        class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center sm:gap-4"
      >
        <a
          href={ctaHref}
          class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {ctaLabel}
        </a>
        <a
          href={secondaryHref}
          class="inline-flex min-h-[44px] items-center justify-center rounded-md border-2 border-primary px-6 py-3 text-base font-bold text-primary transition-colors hover:bg-primary hover:text-primary-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {secondaryLabel}
        </a>
      </div>

      <!-- Tap-to-call -->
      <a
        href={`tel:${client.phoneForTel}`}
        class="inline-flex items-center gap-2 pt-1 text-sm font-semibold text-text-muted transition-colors hover:text-primary"
      >
        <svg
          class="size-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
          ></path>
        </svg>
        Call {client.phoneFormatted}
      </a>
    </div>

    <!-- Hero image -->
    <div
      class="relative order-1 overflow-hidden rounded-lg shadow-xl aspect-4/3 lg:order-2"
      transition:name="hero-image"
    >
      <Image
        src={imageSrc}
        alt={imageAlt}
        width={800}
        height={600}
        loading="eager"
        decoding="async"
        class="size-full object-cover"
      />
    </div>
  </div>
</section>
