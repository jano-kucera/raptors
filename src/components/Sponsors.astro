---
import { sponsorImages, type DiscoveredImage } from "../config/images";
import { Image } from "astro:assets";

interface Props {
  topper?: string;
  heading?: string;
  description?: string;
  images?: DiscoveredImage[];
  ctaLabel?: string;
  ctaHref?: string;
}

const { images = sponsorImages } = Astro.props;
---

<section class="sponsors-section">
  <div class="sponsors-container">
    {
      images.map(({ src, alt }) => (
        <div class="sponsor-logo">
          <Image
            src={src}
            alt={alt}
            width={150}
            loading="lazy"
            class="size-full object-contain"
          />
        </div>
      ))
    }
  </div>
</section>
<style>
  .sponsors-section {
    padding: 2rem 1rem;
    background-color: #f5f5f5;
  }

  .sponsors-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .sponsor-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 80px;
  }

  .sponsor-logo img {
    max-width: 150px;
    max-height: 80px;
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .sponsor-logo img:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .sponsors-container {
      gap: 1rem;
    }

    .sponsor-logo {
      height: 60px;
    }

    .sponsor-logo img {
      max-width: 120px;
      max-height: 60px;
    }
  }
</style>
